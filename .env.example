# Local: SQLite next to schema (prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Production (Docker/Railway volume): persist DB on mounted disk
# DATABASE_URL="file:/data/prisma/prod.db"
# UPLOAD_THEMES_DIR="/data/uploads/themes"

# Optional — xAI chat model (default: grok-4.6)
# XAI_MODEL="grok-4.6"

# Optional — Grok HTTP timeout in ms (default: 900000 = 15 min)
# XAI_TIMEOUT_MS="900000"
